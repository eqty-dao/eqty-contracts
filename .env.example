# Private key for deployment (with 0x prefix)
PRIVATE_KEY=

# RPC URLs (optional - defaults provided)
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan API key for contract verification on Base
ETHERSCAN_API_KEY=

# Existing EQTY deployment (optional)
EQTY_TOKEN_ADDRESS=
REDEEM_CONTRACT_ADDRESS=

# Required for Redeem deployment
FOUNDATION_WALLET=
INITIAL_EXCHANGE_RATE=
REDEEM_AMOUNT=
ANCHOR_ETH_PREMIUM_BPS=2000
EQTY_FEE=10000000000000000000

# Required when Deploy.s.sol or DeployEQTY.s.sol deploys EQTY
BRIDGE_WALLET=

# Optional deployment overrides
MINT_DEADLINE=
MINT_TO=
MINT_AMOUNT=

# Optional: Custom gas settings (in wei)
# BASE_GAS_PRICE=1000000
# BASE_SEPOLIA_GAS_PRICE=1000000
